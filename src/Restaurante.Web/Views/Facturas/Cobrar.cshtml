@model CobrarViewModel
@{
    var o = Model.Orden;
    ViewData["Title"] = $"Cobrar mesa {o.Mesa?.Numero}";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Cobrar · Mesa @o.Mesa?.Numero <small class="text-muted">(orden #@o.Id)</small></h1>
        <div class="card p-3 p-md-4">
            <table class="table table-sm">
                <tbody>
                    @foreach (var d in o.Detalles)
                    {
                        <tr><td>@d.Cantidad × @d.Producto?.Nombre</td><td class="text-end">@d.Subtotal.Pesos()</td></tr>
                    }
                </tbody>
            </table>

            <dl class="row mb-3">
                <dt class="col-7">Subtotal</dt><dd class="col-5 text-end">@o.Total.Pesos()</dd>
                <dt class="col-7">Impoconsumo (8 %)</dt><dd class="col-5 text-end">@Model.Impuesto.Pesos()</dd>
                <dt class="col-7">Propina sugerida (10 %)</dt><dd class="col-5 text-end" id="propina">@Model.Propina.Pesos()</dd>
                <dt class="col-7 fs-5">Total</dt><dd class="col-5 text-end fs-5 fw-bold text-marca" id="total">@((o.Total + Model.Impuesto + Model.Propina).Pesos())</dd>
            </dl>

            <form asp-action="Cobrar" asp-route-id="@o.Id" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Método de pago</label>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var metodo in Enum.GetValues<MetodoPago>())
                        {
                            <input type="radio" class="btn-check" name="metodoPago" id="mp-@metodo" value="@metodo" @(metodo == MetodoPago.Efectivo ? "checked" : "") />
                            <label class="btn btn-outline-secondary" for="mp-@metodo">@metodo.Nombre()</label>
                        }
                    </div>
                </div>
                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" role="switch" id="incluirPropina" name="incluirPropina" value="true" checked />
                    <label class="form-check-label" for="incluirPropina">Incluir propina (voluntaria)</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-marca flex-fill"><i class="bi bi-check2-circle"></i> Confirmar pago</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Recalcula el total al activar/desactivar la propina.
        (function () {
            const fmt = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
            const base = @((o.Total + Model.Impuesto).ToString(System.Globalization.CultureInfo.InvariantCulture));
            const propina = @(Model.Propina.ToString(System.Globalization.CultureInfo.InvariantCulture));
            const check = document.getElementById('incluirPropina');
            check.addEventListener('change', () => {
                document.getElementById('propina').textContent = fmt.format(check.checked ? propina : 0);
                document.getElementById('total').textContent = fmt.format(base + (check.checked ? propina : 0));
            });
        })();
    </script>
}
