@model Factura
@{
    ViewData["Title"] = $"Factura #{Model.Id}";
    var o = Model.Orden!;
}
<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card p-4">
            <div class="text-center mb-3">
                <i class="bi bi-fire text-marca fs-1"></i>
                <h1 class="h4 mb-0">Sazón Caleño</h1>
                <div class="small text-muted">Cali, Valle del Cauca</div>
            </div>
            <div class="d-flex justify-content-between small mb-2">
                <span>Factura <strong>#@Model.Id</strong></span>
                <span>@Model.CreadoEn.ToString("dd/MM/yyyy hh:mm tt")</span>
            </div>
            <div class="small text-muted mb-3">Mesa @o.Mesa?.Numero · Orden #@o.Id · Atendió: @o.MeseroNombre</div>

            <table class="table table-sm">
                <tbody>
                    @foreach (var d in o.Detalles)
                    {
                        <tr><td>@d.Cantidad × @d.Producto?.Nombre</td><td class="text-end">@d.Subtotal.Pesos()</td></tr>
                    }
                </tbody>
            </table>
            <dl class="row mb-0 small">
                <dt class="col-7">Subtotal</dt><dd class="col-5 text-end">@Model.Subtotal.Pesos()</dd>
                <dt class="col-7">Impoconsumo 8 %</dt><dd class="col-5 text-end">@Model.Impuesto.Pesos()</dd>
                <dt class="col-7">Propina</dt><dd class="col-5 text-end">@Model.Propina.Pesos()</dd>
            </dl>
            <div class="d-flex justify-content-between border-top pt-2 fs-5 fw-bold">
                <span>TOTAL</span><span class="text-marca">@Model.Total.Pesos()</span>
            </div>
            <div class="small text-muted mt-2">Pago: @Model.MetodoPago.Nombre() · Cajero: @Model.CajeroNombre</div>
            <p class="text-center small mt-3 mb-0">¡Gracias por su visita!</p>
        </div>
        <div class="d-flex gap-2 mt-3 no-imprimir">
            <button onclick="window.print()" class="btn btn-outline-secondary flex-fill"><i class="bi bi-printer"></i> Imprimir</button>
            <a asp-action="Index" class="btn btn-marca flex-fill">Volver a caja</a>
        </div>
    </div>
</div>
