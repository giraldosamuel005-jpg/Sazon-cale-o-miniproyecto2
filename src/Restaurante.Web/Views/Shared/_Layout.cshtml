@*
    Sazón Caleño · Sistema de órdenes para restaurante
    Miniproyecto 2 · Lenguajes de Programación · Universidad Santiago de Cali · 2026
    Autores: Ángel David Gómez Gómez · Samuel Darío Giraldo Paz
*@

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sazón Caleño</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @{
        var autenticado = User.Identity?.IsAuthenticated == true;
        var esAdmin = User.IsInRole(Roles.Admin);
        var esMesero = User.IsInRole(Roles.Mesero);
        var esCocina = User.IsInRole(Roles.Cocina);
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string c) => controlador == c ? "active" : "";
    }
    @if (autenticado)
    {
        <nav class="navbar navbar-expand-lg navbar-dark barra-principal sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-fire"></i> Sazón Caleño
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        @if (esAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Tablero</a></li>
                        }
                        @if (esAdmin || esMesero)
                        {
                            <li class="nav-item"><a class="nav-link @Activo("Ordenes")" asp-controller="Ordenes" asp-action="Index"><i class="bi bi-receipt"></i> Órdenes</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Mesas")" asp-controller="Mesas" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i> Mesas</a></li>
                            <li class="nav-item"><a class="nav-link @Activo("Facturas")" asp-controller="Facturas" asp-action="Index"><i class="bi bi-cash-coin"></i> Caja</a></li>
                        }
                        @if (esAdmin || esCocina)
                        {
                            <li class="nav-item"><a class="nav-link @Activo("Cocina")" asp-controller="Cocina" asp-action="Index"><i class="bi bi-egg-fried"></i> Cocina</a></li>
                        }
                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i> Administración
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Productos" asp-action="Index"><i class="bi bi-journal-text"></i> Menú / Productos</a></li>
                                    <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Index"><i class="bi bi-graph-up"></i> Reportes</a></li>
                                    <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-people"></i> Usuarios</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 text-white-50 small py-2 py-lg-0">
                        <i class="bi bi-person-circle text-white fs-5"></i>
                        <span class="text-white">@User.NombreVisible()</span>
                        @foreach (var rol in Roles.Todos.Where(r => User.IsInRole(r)))
                        {
                            <span class="badge text-bg-light">@rol</span>
                        }
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="ms-2">
                            <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Salir</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    }

    <main role="main" class="container-xl py-3 py-md-4">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @exito
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3 border-top">
        Sazón Caleño · Miniproyecto 2 · Lenguajes de Programación · USC 2026
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
