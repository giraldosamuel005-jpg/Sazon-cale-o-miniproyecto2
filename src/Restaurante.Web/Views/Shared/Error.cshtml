@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-emoji-frown text-danger" style="font-size:4rem"></i>
    <h1 class="h3 mt-3">Ocurrió un error inesperado</h1>
    <p class="text-muted">Intente de nuevo. Si el problema continúa, informe al administrador.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código de solicitud: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-marca">Volver al inicio</a>
</div>
