@model Orden
@{
    ViewData["Title"] = $"Orden #{Model.Id}";
    var pasos = new[] { EstadoOrden.Pendiente, EstadoOrden.EnPreparacion, EstadoOrden.Lista, EstadoOrden.Entregada, EstadoOrden.Pagada };
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Orden #@Model.Id · Mesa @Model.Mesa?.Numero</h1>
    <span class="badge fs-6 text-bg-@Model.Estado.ColorBootstrap()">@Model.Estado.Nombre()</span>
</div>

@if (Model.Estado != EstadoOrden.Cancelada)
{
    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between text-center small">
            @foreach (var paso in pasos)
            {
                var hecho = paso <= Model.Estado;
                <div class="flex-fill">
                    <i class="bi @(hecho ? "bi-check-circle-fill text-success" : "bi-circle text-muted") fs-4"></i>
                    <div class="@(hecho ? "fw-semibold" : "text-muted")">@paso.Nombre()</div>
                </div>
            }
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead class="table-light"><tr><th>Producto</th><th class="text-center">Cant.</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.Detalles)
                        {
                            <tr>
                                <td>@d.Producto?.Nombre</td>
                                <td class="text-center">@d.Cantidad</td>
                                <td class="text-end">@d.PrecioUnitario.Pesos()</td>
                                <td class="text-end">@d.Subtotal.Pesos()</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end">@Model.Total.Pesos()</td></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card p-3">
            <dl class="mb-0 small">
                <dt>Mesero</dt><dd>@Model.MeseroNombre</dd>
                <dt>Creada</dt><dd>@Model.CreadoEn.ToString("dd/MM/yyyy hh:mm tt")</dd>
                @if (Model.ActualizadoEn is not null)
                {
                    <dt>Último cambio</dt><dd>@Model.ActualizadoEn.Value.ToString("hh:mm tt")</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Notas))
                {
                    <dt>Notas</dt><dd>@Model.Notas</dd>
                }
            </dl>
            <div class="d-grid gap-2 mt-3">
                @if (Model.Estado == EstadoOrden.Lista)
                {
                    <form asp-action="Entregar" asp-route-id="@Model.Id" method="post" class="d-grid">
                        <button class="btn btn-success"><i class="bi bi-check2"></i> Marcar entregada</button>
                    </form>
                }
                @if (Model.Estado == EstadoOrden.Entregada)
                {
                    <a asp-controller="Facturas" asp-action="Cobrar" asp-route-id="@Model.Id" class="btn btn-marca"><i class="bi bi-cash"></i> Cobrar</a>
                }
                @if (Model.Factura is not null)
                {
                    <a asp-controller="Facturas" asp-action="Ver" asp-route-id="@Model.Factura.Id" class="btn btn-outline-secondary"><i class="bi bi-receipt"></i> Ver factura</a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
