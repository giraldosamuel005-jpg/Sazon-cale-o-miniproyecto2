@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <h1 class="h3 mb-3">Nuevo usuario</h1>
        <div class="card p-3 p-md-4">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</div>
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol" class="form-select" asp-items="Roles.Todos.Select(r => new SelectListItem(r, r))"></select>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-marca"><i class="bi bi-save"></i> Crear</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
