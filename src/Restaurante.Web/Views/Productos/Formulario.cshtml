@model Producto
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo producto" : "Editar producto";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        <div class="card p-3 p-md-4">
            <form asp-action="@(esNuevo ? "Crear" : "Editar")" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreadoEn" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-12 col-sm-6">
                        <label asp-for="Precio" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Precio" type="number" step="100" min="100" class="form-control" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label asp-for="Categoria" class="form-label"></label>
                        <select asp-for="Categoria" class="form-select"
                                asp-items="Enum.GetValues<CategoriaProducto>().Select(c => new SelectListItem(c.Nombre(), c.ToString()))"></select>
                    </div>
                </div>
                <div class="form-check form-switch mb-4">
                    <input asp-for="Disponible" class="form-check-input" role="switch" />
                    <label asp-for="Disponible" class="form-check-label">Disponible para pedir</label>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-marca"><i class="bi bi-save"></i> Guardar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
