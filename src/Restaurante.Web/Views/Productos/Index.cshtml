*@

@model List<Producto>
@{
    ViewData["Title"] = "Menú";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Menú del restaurante</h1>
    <a asp-action="Crear" class="btn btn-marca"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

@foreach (var grupo in Model.GroupBy(p => p.Categoria))
{
    <h2 class="h5 mt-4 text-marca">@grupo.Key.Nombre()</h2>
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Producto</th><th class="d-none d-md-table-cell">Descripción</th><th class="text-end">Precio</th><th class="text-center">Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in grupo)
                    {
                        <tr class="@(p.Disponible ? "" : "text-muted")">
                            <td class="fw-semibold">@p.Nombre</td>
                            <td class="d-none d-md-table-cell small">@p.Descripcion</td>
                            <td class="text-end text-nowrap">@p.Precio.Pesos()</td>
                            <td class="text-center">
                                @if (p.Disponible) { <span class="badge text-bg-success">Disponible</span> }
                                else { <span class="badge text-bg-secondary">Agotado</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar @p.Nombre?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
